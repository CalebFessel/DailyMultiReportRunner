# Traumasoft ThirdParty API credentials.
# Copy this file to .env and fill in the real values. Never commit .env.

TS_API_BASE_URL=https://lynxems.traumasoft.com
TS_API_KEY=

# Leave TS_API_SECRET blank if the key-creation screen only issued a key.
# The client then signs with the key itself, and the probe determines which
# HMAC formula the tenant actually accepts.
TS_API_SECRET=

# Signing scheme. Leave unset: the probe detects it and reports what worked.
#   default = hmac_sha256(body + timestamp + nonce, secret)
#   legacy  = hmac_sha256(api_key, timestamp + secret + nonce)
# TS_API_AUTH_MODE=default

# Optional tuning
# TS_API_TIMEOUT=60
# TS_API_MIN_INTERVAL=0.65

# =============================
# Samsara (route dispatch)
# =============================
# Only push_samsara_routes.py uses these. The reporting job does not need them.
# Create a token in Samsara under Settings -> Organization -> API Tokens with
# read access to Vehicles and Addresses and write access to Routes.
SAMSARA_API_TOKEN=

# SAMSARA_API_BASE_URL=https://api.samsara.com
# SAMSARA_API_TIMEOUT=60
# SAMSARA_MIN_INTERVAL=0.4

# SET ONE OF THESE TWO. Measured on this tenant: pickup_time is naive on all
# 18,026 legs of a 30-day window -- not one carries an offset -- and the
# per-leg `timezone` field is empty on 100% of them. The offset can be
# recovered from status timestamps, but only for trips that have already run,
# and this job pushes tomorrow's. So a day of future work states its zone
# nowhere, and without one of these the run refuses to publish rather than
# dispatch every unit four hours early.
#
# Preferred: an IANA zone, resolved against each trip's own date, so it
# follows daylight saving with nobody's diary involved.
SAMSARA_TENANT_TIMEZONE=America/New_York

# Or a fixed offset. Works, but is an hour wrong for half the year unless
# somebody changes it every March and November.
# SAMSARA_TENANT_UTC_OFFSET=-04:00

# Drop-off arrival time when a trip carries no appointment time and no
# drop-off ETA: pickup plus this many minutes. Two thirds of legs on this
# tenant land here, so it drives most drop-off times -- calibrate it rather
# than accepting 45. `probe_samsara_readiness.py --days 30` prints the
# interval the schedulers themselves allow, overall and per level of service.
# An estimate is never allowed to sort past the unit's next pickup.
# SAMSARA_DEFAULT_TRANSPORT_MINUTES=45

# Per level of service. Case- and hyphen-insensitive, so 'Non Emergency' and
# 'Non-Emergency' need only one entry -- but a genuine typo in the source data
# ('Non Amnbulatory') is a different key and needs naming if you want it caught.
# The probe prints a ready-made line for this.
# SAMSARA_TRANSPORT_MINUTES_BY_LOS=ambulatory=30,non ambulatory=35,non emergency=45

# Or estimate each leg from how far it actually goes, which the flat numbers
# cannot express: within one level of service the allowed interval runs from
# 30 to 60 minutes, and what varies is the trip, not the category.
# Section 5c of the probe fits these constants and says whether the distance
# model actually beats the flat one on your data. Do not switch on a hunch --
# if it does not win there, leave this alone.
# SAMSARA_TRANSPORT_MODEL=distance
# SAMSARA_TRANSPORT_BASE_MINUTES=12
# SAMSARA_TRANSPORT_SPEED_MPH=30

# Levels of service never pushed, comma separated, case and hyphen
# insensitive. Empty by default. 'Emergency' is the usual candidate: it is
# dispatched in the moment, so a route built for it the night before
# describes nothing.
# SAMSARA_EXCLUDED_LOS=Emergency

# Call types never pushed to Samsara, matched as case-insensitive substrings.
# SAMSARA_EXCLUDED_CALL_TYPES=standby,cancel,no transport,dry run

# Put the patient's name in the pickup stop notes. OFF by default: a name plus
# a pickup address is PHI, and sending it to Samsara discloses it to a third
# party -- only defensible if Samsara is covered by a BAA. Crews often want it
# to confirm the right patient, so turn it on deliberately if that applies.
# SAMSARA_INCLUDE_PATIENT_NAME=false

# =============================================================================
# PAYCOR (optional) -- pushing Traumasoft punches into payroll
# =============================================================================
# Only needed for push_paycor_timecards.py. probe_punch_quality.py needs none
# of this; it reads Traumasoft alone.
#
# THE ENVIRONMENT GATE. Anything other than the exact string "production"
# resolves to the sandbox, so a typo fails safe. Leave this alone until a
# sandbox run has reconciled cleanly against real punches.
PAYCOR_ENVIRONMENT=sandbox

# From the Paycor developer portal. Required on every call, alongside the
# bearer token -- Paycor wants both.
# PAYCOR_SUBSCRIPTION_KEY=

# Paycor uses an OAuth 2.0 authorization-code grant, so getting the first
# token needs a human in a browser once. The refresh token that falls out is
# what belongs here; the client exchanges it for short-lived access tokens and
# re-exchanges when they expire.
# PAYCOR_REFRESH_TOKEN=
# PAYCOR_CLIENT_ID=
# PAYCOR_CLIENT_SECRET=

# Or paste an access token straight out of the portal to try a read before
# wiring the OAuth flow up. Expires in an hour or so.
# PAYCOR_ACCESS_TOKEN=

# Which legal entity the punches belong to. Paycor scopes timecards by it.
# PAYCOR_LEGAL_ENTITY_ID=

# Paycor rotates the refresh token on use in some configurations. When it does,
# the new value is written straight back into this file, replacing the line it
# came from -- otherwise the next run would authenticate with a credential
# Paycor has already retired, which surfaces as an auth error on a morning
# nobody changed anything.
#
# Set this to false on a host with a read-only checkout, or where the platform
# injects the secret and owns rotation itself. The rotation is still used for
# the current run; only the write-back is skipped.
# PAYCOR_PERSIST_REFRESH_TOKEN=true

# Where to write it back to, if this file is not where the credentials were
# loaded from. Normally left unset -- the path is discovered.
# PAYCOR_ENV_FILE=

# --- Keeping both environments on hand ---------------------------------------
# Sandbox and production are separate Paycor tenants: separate subscription
# keys, separate OAuth clients, separate refresh tokens, and a different legal
# entity id with entirely different employee, department and activity guids.
#
# Prefixing a credential with the environment it belongs to lets both sets sit
# here at once, so switching is a one-line change to PAYCOR_ENVIRONMENT above
# rather than a hand edit of five secrets -- which is how production
# credentials end up pointed at the sandbox, or the reverse, with nothing in
# the output saying so.
#
# A prefixed name wins when the matching environment is selected; the bare
# name above is the fallback. Any of these may be prefixed: SUBSCRIPTION_KEY,
# REFRESH_TOKEN, ACCESS_TOKEN, CLIENT_ID, CLIENT_SECRET, LEGAL_ENTITY_ID.
#
# PAYCOR_SANDBOX_SUBSCRIPTION_KEY=
# PAYCOR_SANDBOX_CLIENT_ID=
# PAYCOR_SANDBOX_CLIENT_SECRET=
# PAYCOR_SANDBOX_REFRESH_TOKEN=
# PAYCOR_SANDBOX_LEGAL_ENTITY_ID=
#
# PAYCOR_PRODUCTION_SUBSCRIPTION_KEY=
# PAYCOR_PRODUCTION_CLIENT_ID=
# PAYCOR_PRODUCTION_CLIENT_SECRET=
# PAYCOR_PRODUCTION_REFRESH_TOKEN=
# PAYCOR_PRODUCTION_LEGAL_ENTITY_ID=

# --- What a punch is filed under ---------------------------------------------
# CreatePunches requires an activityTypeId and Paycor supplies no default, so
# one has to be chosen. Matched by name against the tenant's activity types,
# because the guid differs per tenant. The dry run prints what yours has.
# PAYCOR_ACTIVITY_TYPE=Work

# Or name the guid directly, which is what you need if two activity types
# share a name.
# PAYCOR_ACTIVITY_TYPE_ID=

# departmentId is also required. It normally comes from the employee's own
# Paycor record; this is the fallback for people whose record names none.
# Left empty by default so those punches are refused rather than filed
# somewhere arbitrary.
# PAYCOR_DEFAULT_DEPARTMENT_ID=

# --- Safety rails ------------------------------------------------------------
# How many punch objects go in one CreatePunches batch. Paycor documents no
# ceiling; this one is self-imposed, because a failed batch is diagnosed
# through a single error log and a smaller batch keeps that log readable.
# Remember one Traumasoft punch is TWO objects here, an In and an Out.
# PAYCOR_MAX_PUNCH_BATCH=100

# A punch longer than this is refused rather than sent. A runaway punch
# reaching payroll would pay a multi-day shift.
# PAYCOR_MAX_PUNCH_HOURS=24

# How far apart two clocks can read before the reconciliation calls it drift.
# Matching is by correlation id; this only affects the human-readable report.
# PAYCOR_MATCH_TOLERANCE_MINUTES=2

# --- probe_punch_quality.py --------------------------------------------------
# A closed punch shorter than this is counted as a probable mis-click rather
# than work, so it neither flatters the completion rate nor lands in the hours
# total unremarked.
# PUNCH_SUSPECT_MINUTES=5

# How long after a shift ends an open punch stops being "running late" and
# becomes "nobody is ever closing this".
# PUNCH_STALE_HOURS=2

# --- OTP timestamp selection -------------------------------------------------
# Which trip timestamp counts as "arrived on scene", in preference order. The
# first one present on a leg wins. Default: at_scene.
#
# "At Patient Bedside" is NOT in the default chain, and it is deliberately not
# chained in behind at_scene either. It IS recorded here -- 229 of 385 legs on
# 2026-09-15 -- but it lands after at_scene, so a chain that falls through
# scores some legs at the scene and others at the patient in one column.
#
# Choose one. at_scene covers 95% of completed legs; bedside covers 60% but is
# closer to what the old ePCR field measured. probe_otp_coverage.py prints the
# on-time percentage each choice would publish.
# TS_ARRIVAL_TIMESTAMP_KEYS=at_scene
#
# Which field carries the scheduled pickup, in preference order. Default:
# pickup_time -- the CAD grid's scheduled pickup, and what the old SQL scored
# against.
#
# Do not chain requested_pickup_time in behind it without evidence. That field
# is what the caller asked for before dispatch scheduled anything, so scoring
# against it measures the call taker rather than the crew. Run
# probe_otp_coverage.py first: it shows how many unscored legs each alternative
# would recover and what kind of call they are.
# TS_PICKUP_TIME_KEYS=pickup_time
#
# Minutes either side of the scheduled pickup that still count as on time.
# OTP_ON_TIME_WINDOW_MINUTES=10

# =============================================================================
# ALERTS -- for the unattended runs
# =============================================================================
# Two failures need two mechanisms. A run that BREAKS can shout; a run that
# NEVER HAPPENS cannot, because a machine that is off raises no error and
# silence looks exactly like success. The heartbeat below is the only thing
# that catches the second one.
#
# Every channel is optional. A host with only mail still alerts.

# Who gets told. Mail goes out on every severity.
# ALERT_EMAIL_TO=you@example.com,someone-else@example.com

# Carrier email-to-SMS gateway addresses, for the tier allowed to wake you.
# CRITICAL only -- a failed run or punches that did not reach payroll. Find
# your carrier's gateway (e.g. number@vtext.com, number@txt.att.net).
# ALERT_SMS_TO=5551234567@vtext.com

# A Teams or Slack incoming webhook. CRITICAL and WARNING, so a channel shows
# what needs attention without being woken for routine completions.
# ALERT_WEBHOOK_URL=

# THE DEAD MAN'S SWITCH. Every successful run pings this; the service behind
# it alerts when a ping does not arrive on schedule. Without it, a run that
# never starts is the quietest failure there is -- nothing sends, nothing
# errors, and nobody is paid.
#
# Any cron-monitoring service works (healthchecks.io has a free tier), or an
# internal endpoint if outbound URLs are restricted. Set the expected period
# to slightly longer than the run interval.
# ALERT_HEARTBEAT_URL=

# Which machine an alert came from, so two hosts are told apart. Defaults to
# the Windows computer name.
# ALERT_SOURCE=reporting-01
