# Traumasoft ThirdParty API credentials.
# Copy this file to .env and fill in the real values. Never commit .env.

TS_API_BASE_URL=https://lynxems.traumasoft.com
TS_API_KEY=

# Leave TS_API_SECRET blank if the key-creation screen only issued a key.
# The client then signs with the key itself, and the probe determines which
# HMAC formula the tenant actually accepts.
TS_API_SECRET=

# Signing scheme. Leave unset: the probe detects it and reports what worked.
#   default = hmac_sha256(body + timestamp + nonce, secret)
#   legacy  = hmac_sha256(api_key, timestamp + secret + nonce)
# TS_API_AUTH_MODE=default

# Optional tuning
# TS_API_TIMEOUT=60
# TS_API_MIN_INTERVAL=0.65

# =============================
# Samsara (route dispatch)
# =============================
# Only push_samsara_routes.py uses these. The reporting job does not need them.
# Create a token in Samsara under Settings -> Organization -> API Tokens with
# read access to Vehicles and Addresses and write access to Routes.
SAMSARA_API_TOKEN=

# SAMSARA_API_BASE_URL=https://api.samsara.com
# SAMSARA_API_TIMEOUT=60
# SAMSARA_MIN_INTERVAL=0.4

# Drop-off arrival time when a trip carries no appointment time and no
# drop-off ETA: pickup plus this many minutes.
# SAMSARA_DEFAULT_TRANSPORT_MINUTES=45

# Call types never pushed to Samsara, matched as case-insensitive substrings.
# SAMSARA_EXCLUDED_CALL_TYPES=standby,cancel,no transport,dry run

# Put the patient's name in the pickup stop notes. OFF by default: a name plus
# a pickup address is PHI, and sending it to Samsara discloses it to a third
# party -- only defensible if Samsara is covered by a BAA. Crews often want it
# to confirm the right patient, so turn it on deliberately if that applies.
# SAMSARA_INCLUDE_PATIENT_NAME=false
