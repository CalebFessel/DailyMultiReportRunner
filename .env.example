# Traumasoft ThirdParty API credentials.
# Copy this file to .env and fill in the real values. Never commit .env.

TS_API_BASE_URL=https://lynxems.traumasoft.com
TS_API_KEY=

# Leave TS_API_SECRET blank if the key-creation screen only issued a key.
# The client then signs with the key itself, and the probe determines which
# HMAC formula the tenant actually accepts.
TS_API_SECRET=

# Signing scheme. Leave unset: the probe detects it and reports what worked.
#   default = hmac_sha256(body + timestamp + nonce, secret)
#   legacy  = hmac_sha256(api_key, timestamp + secret + nonce)
# TS_API_AUTH_MODE=default

# Optional tuning
# TS_API_TIMEOUT=60
# TS_API_MIN_INTERVAL=0.65

# =============================
# Samsara (route dispatch)
# =============================
# Only push_samsara_routes.py uses these. The reporting job does not need them.
# Create a token in Samsara under Settings -> Organization -> API Tokens with
# read access to Vehicles and Addresses and write access to Routes.
SAMSARA_API_TOKEN=

# SAMSARA_API_BASE_URL=https://api.samsara.com
# SAMSARA_API_TIMEOUT=60
# SAMSARA_MIN_INTERVAL=0.4

# SET ONE OF THESE TWO. Measured on this tenant: pickup_time is naive on all
# 18,026 legs of a 30-day window -- not one carries an offset -- and the
# per-leg `timezone` field is empty on 100% of them. The offset can be
# recovered from status timestamps, but only for trips that have already run,
# and this job pushes tomorrow's. So a day of future work states its zone
# nowhere, and without one of these the run refuses to publish rather than
# dispatch every unit four hours early.
#
# Preferred: an IANA zone, resolved against each trip's own date, so it
# follows daylight saving with nobody's diary involved.
SAMSARA_TENANT_TIMEZONE=America/New_York

# Or a fixed offset. Works, but is an hour wrong for half the year unless
# somebody changes it every March and November.
# SAMSARA_TENANT_UTC_OFFSET=-04:00

# Drop-off arrival time when a trip carries no appointment time and no
# drop-off ETA: pickup plus this many minutes. Two thirds of legs on this
# tenant land here, so it drives most drop-off times -- calibrate it rather
# than accepting 45. `probe_samsara_readiness.py --days 30` prints the
# interval the schedulers themselves allow, overall and per level of service.
# An estimate is never allowed to sort past the unit's next pickup.
# SAMSARA_DEFAULT_TRANSPORT_MINUTES=45

# Per level of service. Case- and hyphen-insensitive, so 'Non Emergency' and
# 'Non-Emergency' need only one entry -- but a genuine typo in the source data
# ('Non Amnbulatory') is a different key and needs naming if you want it caught.
# The probe prints a ready-made line for this.
# SAMSARA_TRANSPORT_MINUTES_BY_LOS=ambulatory=30,non ambulatory=35,non emergency=45

# Or estimate each leg from how far it actually goes, which the flat numbers
# cannot express: within one level of service the allowed interval runs from
# 30 to 60 minutes, and what varies is the trip, not the category.
# Section 5c of the probe fits these constants and says whether the distance
# model actually beats the flat one on your data. Do not switch on a hunch --
# if it does not win there, leave this alone.
# SAMSARA_TRANSPORT_MODEL=distance
# SAMSARA_TRANSPORT_BASE_MINUTES=12
# SAMSARA_TRANSPORT_SPEED_MPH=30

# Levels of service never pushed, comma separated, case and hyphen
# insensitive. Empty by default. 'Emergency' is the usual candidate: it is
# dispatched in the moment, so a route built for it the night before
# describes nothing.
# SAMSARA_EXCLUDED_LOS=Emergency

# Call types never pushed to Samsara, matched as case-insensitive substrings.
# SAMSARA_EXCLUDED_CALL_TYPES=standby,cancel,no transport,dry run

# Put the patient's name in the pickup stop notes. OFF by default: a name plus
# a pickup address is PHI, and sending it to Samsara discloses it to a third
# party -- only defensible if Samsara is covered by a BAA. Crews often want it
# to confirm the right patient, so turn it on deliberately if that applies.
# SAMSARA_INCLUDE_PATIENT_NAME=false

# =============================================================================
# PAYCOR (optional) -- pushing Traumasoft punches into payroll
# =============================================================================
# Only needed for push_paycor_timecards.py. probe_punch_quality.py needs none
# of this; it reads Traumasoft alone.
#
# THE ENVIRONMENT GATE. Anything other than the exact string "production"
# resolves to the sandbox, so a typo fails safe. Leave this alone until a
# sandbox run has reconciled cleanly against real punches.
PAYCOR_ENVIRONMENT=sandbox

# From the Paycor developer portal. Required on every call, alongside the
# bearer token -- Paycor wants both.
# PAYCOR_SUBSCRIPTION_KEY=

# Paycor uses an OAuth 2.0 authorization-code grant, so getting the first
# token needs a human in a browser once. The refresh token that falls out is
# what belongs here; the client exchanges it for short-lived access tokens and
# re-exchanges when they expire.
# PAYCOR_REFRESH_TOKEN=
# PAYCOR_CLIENT_ID=
# PAYCOR_CLIENT_SECRET=

# Or paste an access token straight out of the portal to try a read before
# wiring the OAuth flow up. Expires in an hour or so.
# PAYCOR_ACCESS_TOKEN=

# Which legal entity the punches belong to. Paycor scopes timecards by it.
# PAYCOR_LEGAL_ENTITY_ID=

# --- The unverified write contract -------------------------------------------
# developers.paycor.com is unreachable from the environment this was built in,
# so the write shape below is a best reading of secondary sources rather than
# something checked against Paycor's reference. Every part of it is a setting
# precisely so that correcting it costs an edit here and not a code change.
# `push_paycor_timecards.py` prints the contract in effect on every run --
# check that output against Paycor's own docs before publishing.
# PAYCOR_PUNCH_WRITE_PATH=v1/legalentities/{legal_entity_id}/timecardpunches
# PAYCOR_PUNCH_WRITE_METHOD=POST
# PAYCOR_PUNCH_FIELD_EMPLOYEE=employeeId
# PAYCOR_PUNCH_FIELD_IN=punchInTime
# PAYCOR_PUNCH_FIELD_OUT=punchOutTime
# PAYCOR_PUNCH_TIME_FORMAT=%Y-%m-%dT%H:%M:%S

# --- Safety rails ------------------------------------------------------------
# How far apart two punches can be and still count as the same punch when
# reconciling. Clocks drift and the two systems round differently; without a
# tolerance every punch reads as a mismatch.
# PAYCOR_MATCH_TOLERANCE_MINUTES=2

# A punch longer than this is refused rather than sent. A runaway punch
# reaching payroll would pay a multi-day shift.
# PAYCOR_MAX_PUNCH_HOURS=24

# --- probe_punch_quality.py --------------------------------------------------
# A closed punch shorter than this is counted as a probable mis-click rather
# than work, so it neither flatters the completion rate nor lands in the hours
# total unremarked.
# PUNCH_SUSPECT_MINUTES=5

# How long after a shift ends an open punch stops being "running late" and
# becomes "nobody is ever closing this".
# PUNCH_STALE_HOURS=2
