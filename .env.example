# ---- shared with Daily_MultiReport_Runner ----
DB_DSN=MyReportingDSN
OUTPUT_DIR=Reports
TEST_MODE=true
TEST_MODE_RECIPIENT=reports-test@example.com
STATUS_EMAIL_RECIPIENT=reports-status@example.com
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=reports@example.com
SMTP_PASS=changeme
SMTP_FROM=reports@example.com

# ---- TraumaSoft -> Samsara work order sync ----
SAMSARA_API_TOKEN=samsara_api_xxxxxxxxx
# SAMSARA_BASE_URL=https://api.samsara.com        # use https://api.eu.samsara.com for EU orgs
# SAMSARA_VEHICLE_MATCH=name                       # name | externalId | vin
# SAMSARA_VEHICLE_EXTERNAL_ID_KEY=traumasoftVehicleId
# SAMSARA_DEFAULT_PRIORITY=Medium
# SAMSARA_SEND_INITIAL_STATUS=true
# TS_TIMEZONE=America/New_York
# TS_WO_TABLE=vm_work_orders
# TS_WO_LOOKBACK_DAYS=30
# TS_WO_EXCLUDE_VEHICLE_IDS=1001,1002,1003
# TS_WO_COLUMN_MAP={"description": ["complaint"], "status": ["wo_status"]}
# TS_WO_STATUS_MAP={"1": "Open", "2": "In Progress", "3": "Completed"}
# TS_WO_PRIORITY_MAP={"1": "Low", "2": "Medium", "3": "High"}
# TS_WO_CATEGORY_MAP={"PM Service": "Preventive"}
# TS_WO_SQL_FILE=sql/work_orders.sql
# SAMSARA_WO_LEDGER_FILE=Reports/State/samsara_workorder_ledger.json
# SAMSARA_WO_LEDGER_DSN=MyStatusDSN                # use a SQL mapping table instead of the JSON file
# SAMSARA_WO_LEDGER_TABLE=samsara_workorder_map
# SAMSARA_WO_LEDGER_DIALECT=mysql                  # mysql | mssql
# SYNC_RECIPIENTS=fleet@example.com,ops@example.com
