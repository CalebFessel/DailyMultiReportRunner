__pycache__/
*.pyc
.env
.venv/
venv/

# Traumasoft ThirdParty API probe output
api_probe/

# Generated report output
Reports/

# Accumulated state. These are this deployment's learned data -- the
# cost-center map, the OOS history -- and the operation's own decisions about
# regions and crew minimums. They belong to the machine that runs the reports,
# not to the repository, and a clone of C:\Reports would otherwise show them
# as untracked forever and invite committing one by accident. The .example
# files stay tracked: they are the templates.
state/*.json
!state/*.example.json

# ---------------------------------------------------------------------------
# Generated artifacts and local scratch.
#
# Everything below is produced BY the scripts rather than read by them, and
# accumulated on a working machine until a clone made it visible. Nothing here
# is tracked today, so these patterns take nothing away; `git add -f` still
# works for the one-off file that genuinely belongs in the repo.
# ---------------------------------------------------------------------------

# Report output, dashboards and archives.
*.zip
*.xlsx
*.csv
*.html

# Local databases. A CDR store holds call records and a geofence store holds
# tenant addresses -- operational data that belongs on the machine that built
# it, never in a repository.
*.db

# Working directories that accumulate beside the reports.
AdHoc/
NetMonitor/
DailyReports/
documentation/

# Probe and diagnostic output. Named one by one rather than ignoring *.json,
# because state/*.example.json and docs/*.json are tracked and a blanket rule
# would quietly drop them.
access_sweep.json
plan.json
tags.json
turnaround_viz.json
uhu_diagnosis.json
uhu_sources.json
